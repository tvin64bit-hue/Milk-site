---
// Стрелка прокрутки горизонтальной ленты. Рисуется той же тонкой обводкой
// со скруглёнными концами, что и дудлы: сторонние наборы иконок в этот
// дизайн не подмешиваются.
interface Props {
  storona: 'nazad' | 'vpered';
}
const { storona } = Astro.props;
const PODPISI = { nazad: 'Прокрутить влево', vpered: 'Прокрутить вправо' };
---
<button
  class:list={['strelka-lenty', `strelka-lenty--${storona}`]}
  type="button"
  data-lenta-strelka={storona}
  aria-label={PODPISI[storona]}
  hidden
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d={storona === 'nazad' ? 'M15 5 8 12l7 7' : 'M9 5l7 7-7 7'} />
  </svg>
</button>

<style>
  .strelka-lenty {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--milk);
    color: var(--ink);
    box-shadow: inset 0 0 0 var(--tolschina-obvodki) var(--beige), var(--ten-myagkaya);
    transition: background-color var(--plavno-navedenie), color var(--plavno-navedenie);
  }
  .strelka-lenty:hover { background: var(--orange); color: var(--white); box-shadow: var(--ten-myagkaya); }
  /* Без этого hidden не работает: display из класса перебивает [hidden],
     и скрытая стрелка продолжала висеть поверх крайней кнопки. */
  .strelka-lenty[hidden] { display: none; }
  .strelka-lenty--nazad { left: 0; }
  .strelka-lenty--vpered { right: 0; }

  /* Пальцем лента листается напрямую, стрелки там только мешали бы. */
  @media (hover: none) {
    .strelka-lenty { display: none; }
  }
</style>
