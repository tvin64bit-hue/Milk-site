---
// Фирменные дудлы. Восемь рисованных иконок в стиле упаковки: тонкая
// обводка со скруглёнными концами, без заливки. Смешивать со сторонними
// наборами иконок нельзя.
export type ImyaDudla =
  | 'butylka' | 'kruassan' | 'chashka' | 'vaflya'
  | 'pirog' | 'pechene' | 'ponchik' | 'roll';

interface Props {
  imya: ImyaDudla;
  razmer?: number;
  klass?: string;
  cvet?: string;
}

const { imya, razmer = 56, klass = '', cvet } = Astro.props;

// Каждый дудл — набор путей в системе координат 48×48.
const DUDLY: Record<ImyaDudla, string[]> = {
  butylka: [
    'M19 6h10v5l4 6v22a3 3 0 0 1-3 3H18a3 3 0 0 1-3-3V17l4-6V6Z',
    'M15 22h18',
    'M15 31h18',
  ],
  kruassan: [
    'M13 33c-3-8 3-15 11-15s14 7 11 15c-1 3-4 3-6 1-2 2-3 3-5 3s-3-1-5-3c-2 2-5 2-6-1Z',
    'M13 33c-3 2-6 1-7-2s1-6 5-6',
    'M35 33c3 2 6 1 7-2s-1-6-5-6',
    'M19 20c1 5 1 9 0 13',
    'M29 20c-1 5-1 9 0 13',
  ],
  chashka: [
    'M11 20h22v10a9 9 0 0 1-9 9h-4a9 9 0 0 1-9-9V20Z',
    'M33 23h3a4 4 0 0 1 0 8h-3',
    'M8 43h28',
    'M19 8c-2 3 2 4 0 7', 'M26 8c-2 3 2 4 0 7',
  ],
  vaflya: [
    // Скруглённый корпус с лёгкой перспективой: верх чуть уже низа.
    'M15 17h18a5 5 0 0 1 5 5v11a4 4 0 0 1-4 4H14a4 4 0 0 1-4-4V22a5 5 0 0 1 5-5Z',
    'M20 17.5v19', 'M28 17.5v19', 'M10.5 24h27', 'M10.5 30h27',
    // Потёк сиропа сверху и капля.
    'M16 17c1-3.4 3-4.6 5.2-3.4 2.2 1.2 2.4 3.4 4.8 3.4s3.2-3 5.4-1.8',
    'M34.6 11.6a2.1 2.1 0 1 1-4.2 0c0-1.4 2.1-3.6 2.1-3.6s2.1 2.2 2.1 3.6Z',
  ],
  pirog: [
    'M9 30c0-8 7-14 15-14s15 6 15 14',
    'M6 30h36c0 7-8 11-18 11S6 37 6 30Z',
    'M13 25c4-2 7-2 11 0s7 2 11 0',
    'M18 18c1 4 1 8 0 12',
    'M30 18c-1 4-1 8 0 12',
  ],
  pechene: [
    'M24 8c9 0 16 7 16 16s-7 16-16 16S8 33 8 24 15 8 24 8Z',
    'M17 19a1.6 1.6 0 1 0 .01 0Z',
    'M29 17a1.6 1.6 0 1 0 .01 0Z',
    'M19 31a1.6 1.6 0 1 0 .01 0Z',
    'M31 28a1.6 1.6 0 1 0 .01 0Z',
    'M24 24a1.6 1.6 0 1 0 .01 0Z',
  ],
  ponchik: [
    'M24 7a17 17 0 1 0 .01 0Z',
    // Отверстие крупное, поэтому кольцо читается толстым.
    'M24 17.5a6.5 6.5 0 1 0 .01 0Z',
    // Волнистый край глазури — восемь фестонов по кругу.
    'M36.5 24A5.6 5.6 0 0 1 32.84 32.84A5.6 5.6 0 0 1 24 36.5A5.6 5.6 0 0 1 15.16 32.84'
      + 'A5.6 5.6 0 0 1 11.5 24A5.6 5.6 0 0 1 15.16 15.16A5.6 5.6 0 0 1 24 11.5'
      + 'A5.6 5.6 0 0 1 32.84 15.16A5.6 5.6 0 0 1 36.5 24Z',
    // Посыпка короткими штрихами по кольцу.
    'M19.6 19.6l1.5 1.5', 'M28.4 19.6l-1.5 1.5',
    'M19.6 28.4l1.5-1.5', 'M28.4 28.4l-1.5-1.5',
  ],
  // Вид сбоку: три цилиндра в ряд узнаются мгновенно, вид сверху
  // читался как стиральная машина.
  roll: [
    'M6.5 15v13a6 3.4 0 0 0 12 0V15', 'M12.5 15a6 3.4 0 1 0 .01 0Z', 'M12.5 16.7a3.9 2.2 0 1 0 .01 0Z',
    'M18 15v13a6 3.4 0 0 0 12 0V15', 'M24 15a6 3.4 0 1 0 .01 0Z', 'M24 16.7a3.9 2.2 0 1 0 .01 0Z',
    'M29.5 15v13a6 3.4 0 0 0 12 0V15', 'M35.5 15a6 3.4 0 1 0 .01 0Z', 'M35.5 16.7a3.9 2.2 0 1 0 .01 0Z',
  ],
};
---
<svg
  class:list={['dudl', klass]}
  width={razmer}
  height={razmer}
  viewBox="0 0 48 48"
  fill="none"
  stroke={cvet ?? 'currentColor'}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  vector-effect="non-scaling-stroke"
  aria-hidden="true"
  focusable="false"
>
  {DUDLY[imya].map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
  {imya === 'butylka' && (
    <text
      class="dudl__nadpis"
      x="24" y="28.4"
      text-anchor="middle"
      font-size="6.2"
      font-weight="700"
      letter-spacing="0.5"
      fill="currentColor"
      stroke="none"
    >MILK</text>
  )}
</svg>

<style>
  /* Цвет наследуется от родителя: в заглушке он кофейный, в фоновом слое бежевый. */
  .dudl { display: block; }
  /* Надпись на этикетке — как в фирменном паттерне на упаковке. */
  .dudl__nadpis { font-family: var(--shrift-zagolovok); }
</style>
