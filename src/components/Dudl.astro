---
// Фирменные дудлы. Восемь рисованных иконок в стиле упаковки: тонкая
// обводка со скруглёнными концами, без заливки. Смешивать со сторонними
// наборами иконок нельзя.
export type ImyaDudla =
  | 'butylka' | 'kruassan' | 'chashka' | 'vaflya'
  | 'pirog' | 'pechene' | 'ponchik' | 'roll';

interface Props {
  imya: ImyaDudla;
  razmer?: number;
  klass?: string;
  cvet?: string;
}

const { imya, razmer = 56, klass = '', cvet } = Astro.props;

// Каждый дудл — набор путей в системе координат 48×48.
const DUDLY: Record<ImyaDudla, string[]> = {
  butylka: [
    'M19 6h10v5l4 6v22a3 3 0 0 1-3 3H18a3 3 0 0 1-3-3V17l4-6V6Z',
    'M15 22h18',
    'M21 29h6',
  ],
  kruassan: [
    'M13 33c-3-8 3-15 11-15s14 7 11 15c-1 3-4 3-6 1-2 2-3 3-5 3s-3-1-5-3c-2 2-5 2-6-1Z',
    'M13 33c-3 2-6 1-7-2s1-6 5-6',
    'M35 33c3 2 6 1 7-2s-1-6-5-6',
    'M19 20c1 5 1 9 0 13',
    'M29 20c-1 5-1 9 0 13',
  ],
  chashka: [
    'M11 20h22v10a9 9 0 0 1-9 9h-4a9 9 0 0 1-9-9V20Z',
    'M33 23h3a4 4 0 0 1 0 8h-3',
    'M8 43h28',
    'M19 8c-2 3 2 4 0 7', 'M26 8c-2 3 2 4 0 7',
  ],
  vaflya: [
    'M10 12h28a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V14a2 2 0 0 1 2-2Z',
    'M18 12v24', 'M28 12v24', 'M8 20h32', 'M8 28h32',
  ],
  pirog: [
    'M9 30c0-8 7-14 15-14s15 6 15 14',
    'M6 30h36c0 7-8 11-18 11S6 37 6 30Z',
    'M13 25c4-2 7-2 11 0s7 2 11 0',
    'M18 18c1 4 1 8 0 12',
    'M30 18c-1 4-1 8 0 12',
  ],
  pechene: [
    'M24 8c9 0 16 7 16 16s-7 16-16 16S8 33 8 24 15 8 24 8Z',
    'M17 19a1.6 1.6 0 1 0 .01 0Z',
    'M29 17a1.6 1.6 0 1 0 .01 0Z',
    'M19 31a1.6 1.6 0 1 0 .01 0Z',
    'M31 28a1.6 1.6 0 1 0 .01 0Z',
    'M24 24a1.6 1.6 0 1 0 .01 0Z',
  ],
  ponchik: [
    'M24 8c9 0 16 7 16 16s-7 16-16 16S8 33 8 24 15 8 24 8Z',
    'M24 18.5a5.5 5.5 0 1 0 .01 0Z',
    'M16.5 15.5l1.6 1.8', 'M31.5 16.5l-1.6 1.8',
    'M14.5 27.5l2.2.6', 'M33.5 27l-2.2.6', 'M24 34.5v-2.3',
  ],
  roll: [
    'M24 7c9.4 0 17 7.6 17 17s-7.6 17-17 17S7 33.4 7 24 14.6 7 24 7Z',
    'M24 12.5c6.3 0 11.5 5.2 11.5 11.5S30.3 35.5 24 35.5 12.5 30.3 12.5 24 17.7 12.5 24 12.5Z',
    'M24 20a4 4 0 1 0 .01 0Z',
    'M18 20.5a1.7 1.7 0 1 0 .01 0Z',
    'M30 20.5a1.7 1.7 0 1 0 .01 0Z',
    'M24 30a1.7 1.7 0 1 0 .01 0Z',
  ],
