---
// Волнистая граница секции. Кривая одна и та же по всему сайту,
// включая нижний край выезжающей панели «Заказать».
//
// Волна заливается цветом следующей секции и накладывается на предыдущую,
// поэтому цвет передаётся снаружи.
interface Props {
  cvet: string;
  /** Перевернуть — для нижнего края панели и секций. */
  vniz?: boolean;
  klass?: string;
}
const { cvet, vniz = false, klass = '' } = Astro.props;
---
<div class:list={['volna', klass, { 'volna--vniz': vniz }]} aria-hidden="true">
  <svg viewBox="0 0 1440 80" preserveAspectRatio="none" focusable="false">
    <path
      d="M0,44 C160,10 320,8 480,34 C640,60 800,74 960,56 C1100,40 1240,18 1440,36 L1440,80 L0,80 Z"
      fill={cvet}
    />
  </svg>
</div>

<style>
  .volna {
    display: block;
    width: 100%;
    height: var(--vysota-volny);
    line-height: 0;
    /* Волна перекрывает предыдущую секцию, не оставляя щели на дробных пикселях. */
    margin-bottom: -1px;
  }
  .volna svg { display: block; width: 100%; height: 100%; }
  .volna--vniz { transform: scaleY(-1); margin-bottom: 0; margin-top: -1px; }
</style>
