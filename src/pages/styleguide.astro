---
// Служебная страница: весь визуальный язык сайта на одном экране.
// В поиск не отдаётся, из карты сайта исключена.
import Bazovyy from '../layouts/Bazovyy.astro';
import Dudl from '../components/Dudl.astro';
import type { ImyaDudla } from '../components/Dudl.astro';
import Volna from '../components/Volna.astro';
import Knopka from '../components/Knopka.astro';
import Metka from '../components/Metka.astro';
import KartochkaBlyuda from '../components/KartochkaBlyuda.astro';
import FotoBlyuda from '../components/FotoBlyuda.astro';
import { BLYUDA, blyudoPoId, blyudaKategorii } from '../lib/menu';
import { put } from '../lib/put';
import { FORMY_BLOBA } from '../../scripts/blob.mjs';
import siluet from '../lib/siluet-logotipa.json';
import vypadayushchie from '../lib/vypadayushchie-fony.json';

const CVETA = [
  ['--milk', '#F8EEE4', 'Основной фон страницы'],
  ['--milk-rose', '#F9E4DA', 'Фон чередующихся секций'],
  ['--cream', '#FFFBF5', 'Карточки, шапка, панель'],
  ['--ink', '#3D2B1C', 'Основной текст и заголовки'],
  ['--ink-muted', '#78644E', 'Состав, вес, зачёркнутая цена'],
  ['--coffee', '#A18152', 'Только декоративные заливки'],
  ['--coffee-deep', '#8A6F47', 'Заливки под светлым текстом'],
  ['--coffee-dark', '#5F3515', 'Тёмные секции и футер'],
  ['--beige', '#E3CFAC', 'Дудлы, разделители, рамки'],
  ['--orange', '#C85111', 'Кнопки, цены, метка «Хит»'],
  ['--orange-dark', '#B04409', 'Наведение на кнопках'],
  ['--error', '#C4432B', 'Ошибки, метка «Острое»'],
] as const;

// Контраст считается прямо здесь, чтобы цифры не расходились с палитрой.
const svetlota = (hex: string) => {
  const k = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
    .map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * k[0] + 0.7152 * k[1] + 0.0722 * k[2];
};
const kontrast = (a: string, b: string) => {
  const [x, y] = [svetlota(a), svetlota(b)].sort((p, q) => q - p);
  return (x + 0.05) / (y + 0.05);
};

const PARY = [
  ['#3D2B1C', '#F8EEE4', '--ink на --milk', 4.5],
  ['#78644E', '#F9E4DA', '--ink-muted на --milk-rose', 4.5],
  ['#78644E', '#FFFBF5', '--ink-muted на --cream', 4.5],
  ['#FFFFFF', '#C85111', 'белый на --orange (кнопка)', 4.5],
  ['#FFFFFF', '#B04409', 'белый на --orange-dark', 4.5],
  ['#FFFBF5', '#8A6F47', '--cream на --coffee-deep', 4.5],
  ['#FFFFFF', '#C4432B', 'белый на --error', 4.5],
  ['#F8EEE4', '#5F3515', '--milk на --coffee-dark', 4.5],
  ['#C85111', '#FFFBF5', '--orange на --cream (цена 22px Rubik 700)', 3],
] as const;

const DUDLY: ImyaDudla[] = ['butylka', 'kruassan', 'chashka', 'vaflya', 'pirog', 'pechene', 'ponchik', 'roll'];
const PODPISI_DUDLOV = ['Бутылка молока', 'Круассан', 'Чашка кофе', 'Вафля', 'Пирог', 'Печенье', 'Пончик', 'Ролл'];

// Четыре типа фона, на которых сняты исходники: под маской они ведут себя по-разному.
const FONY = [
  ['shakshuka', 'Бежевое кресло'],
  ['salat-cezar', 'Светлое дерево'],
  ['filadelfiya-layt', 'Чёрный сланец, после правки'],
  ['kaliforniya-klassik', 'Чисто-белый, после правки'],
] as const;

// Снимки, чей фон выпадает из молочной гаммы, и сводка по типам.
type Vypadayuschiy = { id: string; kategoriya: string; tip: string };
const VYPADAYUSCHIE = vypadayushchie as Vypadayuschiy[];
const SVODKA = Object.entries(
  VYPADAYUSCHIE.reduce<Record<string, Vypadayuschiy[]>>((acc, v) => {
    (acc[v.tip] ??= []).push(v);
    return acc;
  }, {}),
).sort((a, b) => b[1].length - a[1].length);

// В ряд сравнения берём по одному представителю каждого типа.
const VYPADAYUSCHIE_POKAZ = ['kaliforniya-klassik', 'mini-s-lososem', 'vafli-s-bekonom', 'skovoroda-s-rvanoy-govyadinoy']
  .map((id) => VYPADAYUSCHIE.find((v) => v.id === id)!);

// Соседи по каталогу для сравнения в одном ряду.
const SOSEDI = ['filadelfiya-lyuks', 'ebi-tempura', 'tori'] as const;

// Восемь карточек подряд — проверка, читается ли чередование форм.
const VOSEM = ['picca-4-syra', 'shakshuka', 'picca-pepperoni', 'set-hit-n1',
  'picca-korrida', 'borsch', 'picca-gavayskaya', 'salat-cezar'] as const;

const piccy = blyudaKategorii('picca');
const primery = ['shakshuka', 'set-hit-n1', 'mini-s-ogurcom', 'siropy'].map((id) => blyudoPoId(id)!);
const bezFoto = BLYUDA.filter((b) => b.image === null);
---
<Bazovyy
  zagolovok="Визуальный язык — служебная страница | Кафе «Милк»"
  opisanie="Палитра, типографика, состояния элементов, блоб-маски, дудлы и волна."
  kanon="/styleguide"
>
  <meta slot="golova" name="robots" content="noindex, nofollow" />

  <div class="konteyner">
    <header class="shapka-sg">
      <p class="metka-tekst priglushenno">Служебная страница</p>
      <h1>Визуальный язык</h1>
      <p>Всё, из чего собирается сайт. Утверждается здесь, до вёрстки страниц.</p>
    </header>

    <!-- ---------------- Палитра ---------------- -->
    <section class="blok">
      <h2>Палитра</h2>
      <div class="cveta">
        {CVETA.map(([token, hex, gde]) => (
          <div class="cvet">
            <div class="cvet__obrazec" style={`background: ${hex}`}></div>
            <p class="cvet__token melkiy"><code>{token}</code></p>
            <p class="cvet__hex melkiy priglushenno">{hex}</p>
            <p class="cvet__gde melkiy priglushenno">{gde}</p>
          </div>
        ))}
      </div>

      <h3 class="podzagolovok">Контраст</h3>
      <p class="melkiy priglushenno">Порог 4.5:1 для обычного текста, 3:1 для крупного (от 18.66 px полужирного).</p>
      <ul class="kontrasty">
        {PARY.map(([a, b, podpis, porog]) => {
          const k = kontrast(a, b);
          return (
            <li class="kontrast">
              <span class="kontrast__obrazec" style={`background:${b};color:${a}`}>Текст</span>
              <span class="melkiy">{podpis}</span>
              <span class:list={['kontrast__cifra', 'metka-tekst', k >= porog ? 'horosho' : 'ploho']}>
                {k.toFixed(2)}:1 {k >= porog ? '✓' : '✗'}
              </span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- ---------------- Типографика ---------------- -->
    <section class="blok">
      <h2>Типографика</h2>
      <p class="melkiy priglushenno">Заголовки — Rubik, текст — Onest. Размеры плавают между 480 и 1280 px ширины окна.</p>
      <div class="tipografika">
        <div><span class="tip-podpis">H1 · Rubik 700 · 40→72</span><h1>Место, где хорошо</h1></div>
        <div><span class="tip-podpis">H2 · Rubik 700 · 32→48</span><h2>Завтраки, ради которых возвращаются</h2></div>
        <div><span class="tip-podpis">H3 · Rubik 600 · 24→28</span><h3>Заказать в «Милке»</h3></div>
        <div><span class="tip-podpis">H4 · Rubik 600 · 18→20</span><h4>Сет «Хит №1»</h4></div>
        <div><span class="tip-podpis">Текст · Onest 400 · 16→17 · максимум 68 знаков</span>
          <p>Мы придумали «Милк» как место, куда можно прийти в любом настроении. Утром — сесть с ноутбуком и чашкой кофе за столик у окна.</p></div>
        <div><span class="tip-podpis">Мелкий · Onest 400 · 14→15</span>
          <p class="melkiy priglushenno">Шакшука как у мамы: яйца 3 шт, спелые томаты, болгарский перец и кинза</p></div>
        <div><span class="tip-podpis">Метка · Onest 600 · 12→13 · прописные</span>
          <p class="metka-tekst">Ежедневно с 10:00 до 21:00</p></div>
        <div><span class="tip-podpis">Цена · Rubik 700 · 20→22</span><p class="obrazec-ceny">1 250 ₽</p></div>
      </div>
    </section>

    <!-- ---------------- Кнопки ---------------- -->
    <section class="blok">
      <h2>Кнопки и состояния</h2>
      <p class="melkiy priglushenno">Наведите и пройдите табом — заливка главной кнопки наплывает снизу, контур фокуса виден на всех.</p>
      <div class="knopki">
        <div class="knopki__ryad">
          <Knopka vid="glavnaya">Смотреть меню</Knopka>
          <Knopka vid="vtoraya">Все завтраки</Knopka>
          <Knopka vid="ssylka">Назад в меню</Knopka>
        </div>
        <div class="knopki__ryad">
          <Knopka vid="glavnaya" otklyuchena>Недоступна</Knopka>
          <Knopka vid="vtoraya" otklyuchena>Недоступна</Knopka>
        </div>
      </div>

      <h3 class="podzagolovok">Метки</h3>
      <div class="metki-ryad">
        <Metka vid="hit" /><Metka vid="detskoe" /><Metka vid="ostroe" />
        <Metka vid="dobavka" /><Metka vid="net-v-nalichii" />
      </div>

      <h3 class="podzagolovok">Поле ввода</h3>
      <div class="polya">
        <input class="pole" type="search" placeholder="Найти блюдо или ингредиент" aria-label="Поиск по меню" />
        <p class="melkiy priglushenno">Единственное поле ввода на сайте. Форм отправки данных нет.</p>
      </div>
    </section>

    <!-- ---------------- Блоб ---------------- -->
    <section class="blok">
      <h2>Блоб — четыре формы</h2>
      <p class="melkiy priglushenno">В сетке каталога назначаются по кругу: 1-я карточка первая форма, 5-я снова первая.</p>
      <div class="bloby">
        <figure class="blob-obrazec blob-obrazec--etalon">
          <svg viewBox="0 0 1 1" aria-hidden="true"><path d={siluet.put} fill="var(--coffee-dark)" /></svg>
          <figcaption class="melkiy priglushenno">Эталон: силуэт логотипа</figcaption>
        </figure>
        {FORMY_BLOBA.map((d, i) => (
          <figure class="blob-obrazec">
            <svg viewBox="0 0 1 1" aria-hidden="true"><path d={d} fill="var(--coffee)" /></svg>
            <figcaption class="melkiy priglushenno">{['3 волны, широкая', '5 волн, квадратная', '7 волн, вертикальная', '4 волны, наклонная'][i]}</figcaption>
          </figure>
        ))}
      </div>

      <h3 class="podzagolovok">Восемь карточек подряд — видно ли чередование</h3>
      <p class="melkiy priglushenno">
        Формы разведены по частоте волн, пропорции и повороту. Глубже 0.40 впадину
        опускать нельзя: контур превращается в звезду, а её лучи срезают блюдо —
        первой страдает пицца, она занимает почти весь квадрат.
      </p>
      <div class="vosem">
        {VOSEM.map((id, i) => (
          <figure class="vosem__karta">
            <FotoBlyuda blyudo={blyudoPoId(id)!} nomer={i} />
            <figcaption class="melkiy priglushenno">Форма {(i % 4) + 1}</figcaption>
          </figure>
        ))}
      </div>

      <h3 class="podzagolovok">Блоб на четырёх типах фона исходников</h3>
      <p class="melkiy priglushenno">
        72 снимка из 88 сняты на бежевом кресле, дереве или фирменной подложке —
        под маской они держат молочную гамму. Остальные 16 выпадают, разбор ниже.
        Здесь по одному представителю каждого типа на карточке <code>--cream</code>
        и на фоне секции <code>--milk</code>.
      </p>
      <div class="fony">
        {FONY.map(([id, podpis], i) => (
          <figure class="fon">
            <div class="fon__na-karte"><FotoBlyuda blyudo={blyudoPoId(id)!} nomer={i} /></div>
            <div class="fon__na-fone"><FotoBlyuda blyudo={blyudoPoId(id)!} nomer={i} /></div>
            <figcaption class="melkiy priglushenno">{podpis}<br /><code>{id}</code></figcaption>
          </figure>
        ))}
      </div>

      <h3 class="podzagolovok">Выпадающие фоны — {vypadayushchie.length} снимков из 88</h3>
      <p class="melkiy priglushenno">
        Тип фона определяется автоматически по краевой рамке готового кадра
        (<code>scripts/opredelit-fon.mjs</code>), поэтому новые снимки разбираются
        без правки кода. Порядок шагов важен и обратный не работает: сначала
        плотный кроп ближе к блюду, и только потом правка остатка фона.
      </p>
      <ul class="tipy-fona melkiy">
        {SVODKA.map(([tip, spisok]) => (
          <li><strong>{tip}</strong> — {spisok.length}: {spisok.map((v) => v.id).join(', ')}</li>
        ))}
      </ul>

      <p class="ryad-podpis metka-tekst priglushenno">Было</p>
      <div class="ryad-sravneniya">
        {VYPADAYUSCHIE_POKAZ.map((v, i) => (
          <figure class="sravnenie">
            <div class="sravnenie__karta">
              <img class="sravnenie__foto" src={put(`/images/proba/${v.id}-kak-est.webp`)} width="540" height="540" alt="" style={`clip-path: url(#blob-${(i % 4) + 1})`} />
            </div>
            <figcaption class="melkiy priglushenno">{v.tip}</figcaption>
          </figure>
        ))}
        {SOSEDI.map((id, i) => (
          <figure class="sravnenie">
            <div class="sravnenie__karta"><FotoBlyuda blyudo={blyudoPoId(id)!} nomer={i} /></div>
            <figcaption class="melkiy priglushenno">тёплый</figcaption>
          </figure>
        ))}
      </div>

      <p class="ryad-podpis metka-tekst priglushenno">Стало</p>
      <div class="ryad-sravneniya">
        {VYPADAYUSCHIE_POKAZ.map((v, i) => (
          <figure class="sravnenie">
            <div class="sravnenie__karta"><FotoBlyuda blyudo={blyudoPoId(v.id)!} nomer={i} /></div>
            <figcaption class="melkiy priglushenno"><code>{v.id}</code></figcaption>
          </figure>
        ))}
        {SOSEDI.map((id, i) => (
          <figure class="sravnenie">
            <div class="sravnenie__karta"><FotoBlyuda blyudo={blyudoPoId(id)!} nomer={i} /></div>
            <figcaption class="melkiy priglushenno"><code>{id}</code></figcaption>
          </figure>
        ))}
      </div>

      <p class="melkiy priglushenno">
        Белый фон заменяется молочным — это работает. Тёмный и холодный серый
        только плотнее кадрируются и слегка согреваются: подъём теней делает
        снимок мутно-серым, и он выпадает из ряда не меньше прежнего.
        Восемь тёмных кадров обработкой не спасти, это кандидаты на пересъёмку.
      </p>
    </section>

    <!-- ---------------- Дудлы ---------------- -->
    <section class="blok">
      <h2>Дудлы</h2>
      <p class="melkiy priglushenno">Восемь иконок, обводка 1.5 px, скруглённые концы, без заливки. Слой параллакса — в блоке 7.</p>
      <div class="dudly">
        {DUDLY.map((imya, i) => (
          <figure class="dudl-obrazec">
            <Dudl imya={imya} razmer={72} />
            <figcaption class="melkiy priglushenno">{PODPISI_DUDLOV[i]}</figcaption>
          </figure>
        ))}
      </div>
      <div class="dudly-na-fone">
        <p class="melkiy">Так они выглядят на фоне секции — прозрачность 25–40 %, размер 40–90 px:</p>
        <div class="dudly-fon">
          {DUDLY.map((imya, i) => (
            <Dudl imya={imya} razmer={40 + (i % 4) * 16} klass="dudl-fonovyy" />
          ))}
        </div>
      </div>
    </section>

    <!-- ---------------- Волна ---------------- -->
    <section class="blok">
      <h2>Волна между секциями</h2>
      <p class="melkiy priglushenno">Одна и та же кривая по всему сайту, включая нижний край панели «Заказать». 80 px на десктопе, 40 на мобильном.</p>
    </section>
  </div>

  <div class="volna-demo">
    <div class="volna-demo__verh"><p class="konteyner melkiy">Секция на <code>--milk</code></p></div>
    <Volna cvet="var(--milk-rose)" />
    <div class="volna-demo__seredina"><p class="konteyner melkiy">Секция на <code>--milk-rose</code></p></div>
    <Volna cvet="var(--coffee-dark)" />
    <div class="volna-demo__niz"><p class="konteyner melkiy">Тёмная секция на <code>--coffee-dark</code></p></div>
    <Volna cvet="var(--milk)" />
  </div>

  <div class="konteyner">
    <!-- ---------------- Карточки ---------------- -->
    <section class="blok">
      <h2>Карточка блюда</h2>
      <p class="melkiy priglushenno">Формы масок чередуются. Наведите — карточка поднимается, фото увеличивается до 1.05.</p>
      <div class="setka">
        {primery.map((b, i) => <KartochkaBlyuda blyudo={b} nomer={i} />)}
      </div>

      <h3 class="podzagolovok">Позиции без фотографии — заглушка</h3>
      <p class="melkiy priglushenno">Блоб цвета <code>--beige</code> с дудлом по центру. В подборки на главной такие позиции не идут, только в каталог.</p>
      <div class="setka setka--tri">
        {bezFoto.map((b, i) => <KartochkaBlyuda blyudo={b} nomer={i} />)}
      </div>

      <h3 class="podzagolovok">Контрольный лист: семь пицц с долей среза 69 %</h3>
      <p class="melkiy priglushenno">У пицц фотография вплотную касается вшитого заголовка, поэтому доля среза задана вручную в <code>scripts/lib-images.mjs</code>.</p>
      <div class="setka">
        {piccy.map((b, i) => <KartochkaBlyuda blyudo={b} nomer={i} />)}
      </div>
    </section>

    <!-- ---------------- Форма и отступы ---------------- -->
    <section class="blok">
      <h2>Форма и отступы</h2>
      <div class="forma">
        <div class="forma__obrazec forma__knopka">Капсула 999 px</div>
        <div class="forma__obrazec forma__karta">Карточка 24 px</div>
        <div class="forma__obrazec forma__metka">Метка 12 px</div>
      </div>
      <h3 class="podzagolovok">Тень</h3>
      <div class="teni">
        <div class="ten-obrazec ten-obrazec--myagkaya">Мягкая</div>
        <div class="ten-obrazec ten-obrazec--osnovnaya">Основная, максимум по ТЗ</div>
      </div>
      <h3 class="podzagolovok">Шкала отступов</h3>
      <div class="shkala">
        {[4, 8, 12, 16, 24, 32, 48, 64, 96, 128].map((v) => (
          <div class="shkala__punkt">
            <div class="shkala__polosa" style={`width:${v}px`}></div>
            <span class="melkiy priglushenno">{v}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</Bazovyy>

<style>
  .shapka-sg { padding-block: var(--otstup-8) var(--otstup-6); }
  .blok { padding-block: var(--otstup-8); border-top: 1px solid var(--beige); }
  .blok > h2 { margin-bottom: var(--otstup-5); }
  .podzagolovok { margin-top: var(--otstup-8); margin-bottom: var(--otstup-3); }

  /* Палитра */
  .cveta { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--otstup-4); }
  .cvet__obrazec { height: 88px; border-radius: var(--skruglenie-metka); box-shadow: inset 0 0 0 1px rgba(61,43,28,0.08); }
  .cvet p { margin: var(--otstup-1) 0 0; max-width: none; }
  .cvet__token code { font-weight: 600; }

  .kontrasty { display: grid; gap: var(--otstup-2); margin-top: var(--otstup-4); }
  .kontrast { display: grid; grid-template-columns: 88px minmax(0, 1fr) auto; align-items: center; gap: var(--otstup-4); }
