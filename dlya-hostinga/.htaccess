# Корневой .htaccess домена web-styles.ru — кладётся в public_html.
#
# Единственная его задача: увести весь домен на https. Правила отдельных
# сайтов живут в их собственных папках и здесь не дублируются.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ключевая строка. Без неё правило ниже не подействует внутри папок,
    # где есть свой .htaccess с RewriteEngine On: набор правил дочерней
    # папки по умолчанию не дополняет родительский, а полностью заменяет
    # его. Так устроен /milk-site — со своей маршрутизацией и RewriteBase.
    #
    # InheritDownBefore передаёт эти правила во все вложенные папки и
    # ставит их перед местными. Именно перед: в /milk-site первым делом
    # существующие файлы отдаются как есть, и обработка на них
    # обрывается — стой перенаправление после, картинки, стили и шрифты
    # продолжали бы отдаваться по http, а браузер показывал бы замок с
    # предупреждением.
    #
    # Директива появилась в Apache 2.4.8. Если хостинг вдруг откатится на
    # версию старше, эта строка станет причиной ошибки 500 — тогда её надо
    # убрать, а перенаправление прописать в каждой папке отдельно.
    RewriteOptions InheritDownBefore

    # Защищённость соединения проверяется несколькими способами, потому что
    # перед Apache стоит nginx: шифрование заканчивается на нём, а сам
    # Apache видит обычный http и о настоящем протоколе узнаёт только из
    # заголовков. Какие именно заголовки шлёт прокси, зависит от его
    # настройки, поэтому перечислены все распространённые — достаточно
    # одного признака, чтобы перенаправления не было.
    #
    # Проверяй тут только %{HTTPS}, вышла бы бесконечная петля: Apache за
    # прокси всегда отвечал бы «не https» и всегда перенаправлял бы на
    # адрес, который сам же снова считает незащищённым.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP:X-Forwarded-SSL} !=on
    RewriteCond %{HTTP:X-Forwarded-Port} !=443
    RewriteCond %{SERVER_PORT} !=443
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
