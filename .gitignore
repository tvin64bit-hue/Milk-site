node_modules/
dist/
.astro/
.DS_Store
npm-debug.log*

# Обработанные изображения пересобираются командой «npm run images»
# из Referens, поэтому в репозитории не хранятся.
public/images/

# Временные диагностические скрипты в корне: пишутся рядом с проектом,
# чтобы видеть node_modules, и в репозиторий попадать не должны.
_*.mjs

# Локальный корень для встроенного сервера PHP: повторяет подпапку хостинга
.php-koren/milk-site
# Данные PHP-версии: menu.json там переписывает админка на сервере,
# а журнал ошибок и резервные копии — рабочий мусор
sayt/dannye/oshibki.log
sayt/dannye/kopii/*
!sayt/dannye/kopii/.gitkeep
# Картинки для PHP-версии готовит npm run images, как и для прежней сборки
sayt/images/
