node_modules/
dist/
.astro/
.DS_Store
npm-debug.log*

# Обработанные изображения пересобираются командой «npm run images»
# из Referens, поэтому в репозитории не хранятся.
public/images/

# Временные диагностические скрипты в корне: пишутся рядом с проектом,
# чтобы видеть node_modules, и в репозиторий попадать не должны.
_*.mjs

# Локальный корень для встроенного сервера PHP: повторяет подпапку хостинга
.php-koren/milk-site
# Данные PHP-версии: menu.json там переписывает админка на сервере,
# а журнал ошибок и резервные копии — рабочий мусор
sayt/dannye/oshibki.log
sayt/dannye/kopii/*
!sayt/dannye/kopii/.gitkeep
# Картинки для PHP-версии готовит npm run images, как и для прежней сборки
sayt/images/
# Шрифты в sayt/ — копия public/fonts, её кладёт npm run sayt. Сами файлы
# шрифтов в репозитории есть: без них сайт меняет вид, а качать их с
# Google при каждой выгрузке незачем
sayt/fonts/

# Данные, которые появляются только во время работы админки
sayt/dannye/popytki.json
sayt/dannye/dostup-*.php
# Хеш пароля вне корня сайта: локальный аналог «вне public_html» для
# встроенного сервера разработки. На хостинге такой папки в репозитории
# не будет вовсе — она живёт снаружи выгруженных файлов.
/milk-dostup/

# Контрольные листы служебных скриптов
otchety/

# Архив для загрузки на хостинг — собирается командой npm run zip
milk-site-sayt.zip
