# Данные и резервные копии не должны открываться из браузера:
# menu.json отдаётся страницами, а не напрямую, а файл доступа хранит
# хеш пароля админки.
#
# Записано дважды, потому что у Apache 2.2 и 2.4 разный синтаксис запрета.
# mod_authz_core есть только в 2.4 — по нему версия и различается. Если
# оставить только старый вариант, на 2.4 без модуля совместимости выйдет
# не запрет, а пятисотая ошибка на всю папку.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
